{
  "name": "@desk/cli",
  "version": "0.1.0",
  "description": "The Desk CLI: launches the server, opens the viewer, and prints MCP registration snippets.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "desk": "./bin/desk.mjs",
    "desk-channel": "./bin/desk-channel.mjs"
  },
  "files": ["bin", "dist", "viewer/dist"],
  "scripts": {
    "dev": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "bundle": "bun run scripts/build-dist.ts",
    "prepack": "bun run scripts/build-dist.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "puppeteer-core": "^25.0.4"
  },
  "devDependencies": {
    "@desk/server": "workspace:*",
    "@desk/channel": "workspace:*"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
